# Used only by range mode: `nap START END`
NAP_INPUT_DIR=~/path/to/nimslo
NAP_GIF_OUTPUT_DIR=~/path/to/wigglegrams
NAP_MP4_OUTPUT_DIR=~/path/to/wigglegrams/output_mp4
# Optional. `nap START END --stills` writes full-resolution print stills here.
# NAP_STILLS_OUTPUT_DIR=~/path/to/wigglegrams/stills

# NAP_QUALITY=best
# NAP_MP4_LOOPS=1
# NAP_CENTER_SUBJECT=true
