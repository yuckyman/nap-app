# Used by range mode: `nap START END`
# The library is one folder per batch number: wigglegrams/176/176.gif, 176.mp4, and 01_… stills.
NAP_INPUT_DIR=~/path/to/nimslo
NAP_GIF_OUTPUT_DIR=~/path/to/wigglegrams

